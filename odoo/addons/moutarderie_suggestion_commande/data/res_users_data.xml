<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Compte technique du backend auto-proposal : sans mot de passe, connexion par clé API.
             L'e-mail est obligatoire : Odoo refuse de notifier le vendeur assigné (opportunité,
             activité) si l'auteur n'a pas d'adresse. -->
        <record id="user_suggestions_automatiques" model="res.users">
            <field name="name">Suggestions automatiques</field>
            <field name="login">suggestions.auto</field>
            <field name="email">suggestions.auto@example.com</field>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>
    </data>
</odoo>
