# Odoo JSON-2 API Configuration
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database_name
ODOO_API_KEY=your_json2_api_key_here

# LLM Configuration
# Uses Google Gemini via OpenRouter for stock replenishment predictions
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Odoo XML-RPC account used by the backend (Odoo < v19)
# Dedicated "Suggestions automatiques" user created by the moutarderie_suggestion_commande module
ODOO_USERNAME=suggestions.auto
# API key of that account, generated once per database (local, staging, prod) — never commit it
ODOO_PASSWORD=<clé API du compte « Suggestions automatiques »>
# mail.activity.type id of "Suggestion commande" in this database (empty = value in src/config/auto-proposal.ts)
ODOO_SUGGESTION_ACTIVITY_TYPE_ID=
